  pageId          String?
  postId          String?
  integrationId   String?  // null if this is a platform placement
  source          PlacementSource
  slot            PlacementSlot
  priority        Int      @default(50)  // lower = higher priority
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  page            SpecialPage?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post            Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  integration     AdIntegration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([postId])
  @@index([integrationId])
}

enum PlacementSource {
  USER_INTEGRATION
  PLATFORM_DIRECT
  PLATFORM_NETWORK
}

enum PlacementSlot {
  HEADER
  AFTER_FIRST_BLOCK
  MID_CONTENT
  BEFORE_FOOTER
  FOOTER
  SIDEBAR
}

