// Earnova — Refined Architecture v2.0 (Prisma Schema)
// Implements the data model from chapters 2,3,4,5,7,8 of the architecture spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS & AUTH ────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  username        String?  @unique   // globally unique handle (e.g. "kingsley")
  usernameLower   String?  @unique   // case-insensitive lookup field
  passwordHash    String?
  image           String?
  coverImage      String?
  role            UserRole @default(USER)
  bio             String?
  country         String?
  timezone        String   @default("UTC")
  locale          String   @default("en")
  emailVerified   DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  profileVisibility ProfileVisibility @default(PUBLIC)
  interests       String?  // JSON array of interest tags
  website         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pages           SpecialPage[]
  posts           Post[]
  adIntegrations  AdIntegration[]
  subscriptions    CreatorSubscription[]
  moderationActions ModerationEvent[]
  disclaimerAcks  EarningsDisclaimerAck[]
  sessions        Session[]
  emailVerifications EmailVerificationToken[]
  passwordResets  PasswordResetToken[]
  auditLogs       AuditLog[]
  socialLinks     SocialLink[]
  profileViews    ProfileView[]

  @@index([role])
  @@index([emailVerified])
  @@index([usernameLower])
}

enum ProfileVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model SocialLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String   // "twitter", "instagram", "youtube", "facebook", "tiktok", "telegram", "website"
  url          String
  label        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([userId, platform])
  @@index([userId])
}

model ProfileView {
  id           String   @id @default(cuid())
  profileOwnerId String
  profileOwner  User     @relation(fields: [profileOwnerId], references: [id], onDelete: Cascade)
  visitorId    String?  // Earnova user ID if logged in, null for anonymous
  viewedAt     DateTime @default(now())
  source       String?  // "direct", "search", "social", "earnova"
  country      String?

  @@index([profileOwnerId, viewedAt])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  // Security tracking
  userAgent    String?
  ipAddress    String?   // hashed or partial for privacy
  lastActivity DateTime @default(now())
  revokedAt    DateTime?  // null = active, non-null = revoked

  @@index([userId])
  @@index([expiresAt])
}

// ─── SECURITY: EMAIL VERIFICATION ────────────────────────────────────────────

model EmailVerificationToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique   // secure random token
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ─── SECURITY: PASSWORD RESET ───────────────────────────────────────────────

model PasswordResetToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique   // secure random token
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ─── SECURITY: AUDIT LOG ────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String   // e.g. "user.suspend", "ad.approve", "policy.change"
  resource     String?  // e.g. "user:abc123", "page:def456"
  previousState String?  // JSON snapshot of previous state
  newState     String?   // JSON snapshot of new state
  reason       String?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ─── SECURITY: PERMISSIONS (RBAC) ────────────────────────────────────────────

model Permission {
  id           String   @id @default(cuid())
  key          String   @unique   // e.g. "users.read", "ads.approve", "pages.moderate"
  description  String?
  createdAt    DateTime @default(now())

  roles        RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  permissionKey String
  permission   Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  role         UserRole
  createdAt    DateTime @default(now())

  @@unique([permissionKey, role])
  @@index([role])
}

// ─── PLATFORM: FEATURE FLAGS ────────────────────────────────────────────────

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique   // e.g. "ENABLE_POSTS", "ENABLE_USER_ADS"
  description  String?
  enabled      Boolean  @default(true)
  config       String?  // JSON: additional config
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// ─── PLATFORM: SYSTEM SETTINGS ──────────────────────────────────────────────

model SystemSetting {
  id           String   @id @default(cuid())
  key          String   @unique   // e.g. "platform.name", "maintenance.mode"
  value        String   // JSON or plain string
  description  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// ─── AD NETWORKS & COMPATIBILITY (Chapter 2) ─────────────────────────────────

model AdNetwork {
  id                      String   @id @default(cuid())
  code                    String   @unique  // "adsterra", "monetag", "platform"
  displayName             String
  integrationTypes        String   // JSON array as string (sqlite limitation)
  requiresSiteVerification Boolean @default(true)
  policyDocUrl             String?
  status                  AdNetworkStatus @default(ACTIVE)
  tcfVendorId             Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  integrations    AdIntegration[]
  compatA         AdNetworkCompatibility[] @relation("compatA")
  compatB         AdNetworkCompatibility[] @relation("compatB")
  vendorMappings  AdNetworkVendorMapping[]
  platformIntegrations PlatformAdNetworkIntegration[]

  @@index([status])
}

enum AdNetworkStatus {
  ACTIVE
  DEPRECATED
  BANNED
}

model AdNetworkCompatibility {
  id                       String   @id @default(cuid())
  networkAId               String
  networkBId               String
  verdict                  CompatibilityVerdict
  maxSimultaneousUnits     Int?
  minVerticalSeparationPx  Int?
  requiredContentClassBetween String?
  notes                    String?
  updatedAt                DateTime @updatedAt

  networkA   AdNetwork @relation("compatA", fields: [networkAId], references: [id], onDelete: Cascade)
  networkB   AdNetwork @relation("compatB", fields: [networkBId], references: [id], onDelete: Cascade)

  @@unique([networkAId, networkBId])
}

enum CompatibilityVerdict {
  ALLOWED
  ALLOWED_WITH_LIMITS
  FORBIDDEN
}

model AdPlacementPolicy {
  id                       String   @id @default(cuid())
  name                     String   @unique  // "global"
  maxAdUnitsPerPage        Int      @default(4)
  maxPlatformAdsPerPage    Int      @default(2)
  maxUserAdsPerPage        Int      @default(2)
  minContentBetweenAdsPx   Int      @default(200)
  platformAdsEnabled       Boolean  @default(true)
  userAdsEnabled           Boolean  @default(true)
  newIntegrationsManual    Boolean  @default(true)
  globalKillSwitch         Boolean  @default(false)
  userAdFormatSelection    Boolean  @default(true)
  adSlotResponsive         Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// ─── AD SLOT CONFIGURATION (admin-configurable per-slot policy) ──────────────
//
// One row per (slot, source) pair. Lets the admin decide:
//   * Whether a particular slot (HEADER, FOOTER, etc.) is enabled for platform
//     ads, user ads, or both.
//   * Which integration types (BANNER, IN_PAGE, NATIVE, etc.) are allowed in
//     that slot — enforced at placement time.
//   * Which specific VERIFIED PlatformAdNetworkIntegration is assigned to that
//     slot (replaces the old `platformIntegrations[0]` round-robin matcher,
//     which caused duplicate Adsterra atOptions collisions when multiple slots
//     shared the same integration).
//   * The default priority (lower = appears higher on page).
//   * Visibility rules — when to render the slot at all:
//       'ALWAYS'                   → render even if no ad available (placeholder)
//       'ONLY_WHEN_AD_AVAILABLE'    → hide the slot if no ad is live (default)
//       'NEVER'                     → slot is disabled entirely
//
// The placement engine + /api/p/[slug] route read this table to decide which
// slots render and which integration is used. The admin UI in
// src/components/admin/slot-config-section.tsx lets admins edit it.
model AdSlotConfig {
  id                       String         @id @default(cuid())
  slot                     PlacementSlot
  source                   PlacementSource
  enabled                  Boolean        @default(true)
  // Comma-separated list of IntegrationType allowed in this slot, e.g.
  // "BANNER,NATIVE" — empty string means "any integration type allowed".
  allowedIntegrationTypes  String         @default("")
  // If set, this specific platform integration is used for the slot.
  // If null, the engine round-robins among VERIFIED platform integrations
  // that match `allowedIntegrationTypes` (with collision avoidance).
  assignedIntegrationId     String?
  // Default priority used when seeding placements for new pages.
  defaultPriority          Int            @default(50)
  // Visibility rule for this slot.
  //   ALWAYS                   → always render slot (even without ad)
  //   ONLY_WHEN_AD_AVAILABLE   → render slot only when a live ad exists
  //   NEVER                    → slot disabled
  visibility               String         @default("ONLY_WHEN_AD_AVAILABLE")
  updatedAt                DateTime       @updatedAt

  @@unique([slot, source])
  @@index([slot])
  @@index([source])
}

// ─── CONSENT (Chapter 3) ─────────────────────────────────────────────────────

model ConsentRecord {
  id           String   @id @default(cuid())
  visitorId    String   // first-party anonymous ID
  tcString     String   // IAB TCF v2.2 consent string (or simplified)
  jurisdiction String   // EU, UK, CA, OTHER
  source       String   // "banner", "prior", "default_grant"
  capturedAt   DateTime @default(now())
  expiresAt    DateTime

  @@index([visitorId])
  @@index([expiresAt])
}

model AdNetworkVendorMapping {
  id              String   @id @default(cuid())
  adNetworkId     String
  tcfVendorId     Int
  purposes        String   // JSON array
  adNetwork       AdNetwork @relation(fields: [adNetworkId], references: [id], onDelete: Cascade)
  @@unique([adNetworkId, tcfVendorId])
}

// ─── SPECIAL PAGES & CONTENT BLOCKS ──────────────────────────────────────────

model SpecialPage {
  id              String   @id @default(cuid())
  slug            String   @unique  // e.g. "kingsley-christmas"
  title           String
  description     String?
  pageType        PageType @default(PERSONAL)
  ownerId         String
  campaignId      String?
  moderationState ModerationState @default(PENDING)
  consentRequired Boolean  @default(true)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  blocks          ContentBlock[]
  placements      AdPlacement[]
  trustScores     TrustScore[]
  moderationEvents ModerationEvent[]
  posts           Post[]
  analytics       PageAnalytics?

  @@index([ownerId])
  @@index([campaignId])
  @@index([moderationState])
}

enum PageType {
  PERSONAL
  CREATOR
  MUSIC
  GAMING
  PHOTOGRAPHY
  BLOGGER
  BUSINESS
  STUDENT
  EVENT
  CELEBRATION
  PROFESSIONAL
  LINK_HUB
}

enum ModerationState {
  PENDING
  APPROVED
  RESTRICTED
  SUSPENDED
  BANNED
}

// ─── POSTS SYSTEM (Phase 3 — Content Platform) ───────────────────────────────
//
// A first-class Post entity, separate from SpecialPage + ContentBlock.
//
// Per spec section 8:
//   "A Special Page is a destination. A Post is fresh content."
//
// Posts support: text, image, video, article, link, poll, event, announcement,
// question, quiz, card, gallery.
//
// Lifecycle states (spec section 8):
//   DRAFT → SCHEDULED → PUBLISHED → ARCHIVED
//                 ↘ UNDER_REVIEW ↗
//                              ↘ REMOVED
//
// Posts can be standalone (no pageId) or attached to a Special Page.
// A creator's feed consists of their published posts; the platform's
// explore/discovery feed surfaces posts across creators.

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  REMOVED
  UNDER_REVIEW
}

enum PostType {
  TEXT         // plain text update (like a tweet)
  ARTICLE      // long-form with rich text
  IMAGE        // single image
  GALLERY      // multiple images
  VIDEO        // external embed or hosted video
  LINK         // link share with preview
  POLL         // voting poll
  EVENT        // event announcement
  ANNOUNCEMENT // creator announcement
  QUESTION     // Q&A style
  QUIZ         // interactive quiz
  CARD         // greeting card / social card
}

enum PostVisibility {
  PUBLIC    // anyone can view, indexed by search
  UNLISTED  // only via direct link, not indexed
  PRIVATE   // only the author (drafts/private notes)
}

model Post {
  id              String        @id @default(cuid())
  authorId        String
  // Optional: a post can be attached to a Special Page (e.g., a page owner
  // posts updates on their page) or stand alone on the creator's profile.
  pageId          String?
  slug            String        // unique per author — used in /post/[slug] URLs
  title           String
  excerpt         String?       // short summary for feeds/previews (auto-generated if null)
  content         String        // JSON: array of content blocks (paragraphs, embeds, polls, etc.)
  type            PostType      @default(TEXT)
  status          PostStatus    @default(DRAFT)
  visibility      PostVisibility @default(PUBLIC)
  coverImage      String?
  // Scheduling — when status=SCHEDULED, scheduledAt is when it auto-publishes.
  scheduledAt     DateTime?
  publishedAt     DateTime?
  // SEO metadata (auto-generated from title/excerpt if not set)
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  // Engagement counters (kept denormalized for fast feed reads)
  viewCount       Int           @default(0)
  likeCount       Int           @default(0)
  commentCount   Int           @default(0)
  shareCount     Int           @default(0)
  saveCount      Int           @default(0)
  // Moderation
  moderationState ModerationState @default(PENDING)
  // Optional campaign association (e.g., Christmas 2026 posts)
  campaignId      String?
  // Tags — comma-separated simple tags for now (topics/categories come in Phase 5)
  tags            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  page            SpecialPage?  @relation(fields: [pageId], references: [id], onDelete: SetNull)
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  moderationEvents ModerationEvent[]
  placements      AdPlacement[]

  @@unique([authorId, slug])   // post slug is unique per author (e.g. /@kingsley/my-first-post)
  @@index([authorId, status, publishedAt])  // feed query: author's published posts by date
  @@index([status, publishedAt])            // global feed: all published posts by date
  @@index([pageId, status])                 // page's published posts
  @@index([campaignId, status])             // campaign posts
  @@index([moderationState])
}

model ContentBlock {
  id          String   @id @default(cuid())
  pageId      String
  type        BlockType
  data        String   // JSON blob with block-specific content
  order       Int      // 0-indexed sort order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page        SpecialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

enum BlockType {
  TEXT
  IMAGE
  VIDEO
  LINK
  SOCIAL_LINK
  MUSIC
  POLL
  QUOTE
  STATISTICS
  EVENT
  LOCATION
  PRODUCT
  HEADING
  DIVIDER
}

// ─── AD INTEGRATIONS & PLACEMENTS (Chapter 7 — Lifecycle) ────────────────────

model AdIntegration {
  id                String   @id @default(cuid())
  userId            String
  adNetworkId       String
  integrationType   IntegrationType
  siteIdentifier    String?   // the website/domain registered at the network
  zoneIdentifier    String?   // zone/tag ID from the network
  zoneKey           String?   // ad-network-specific zone key (e.g. Adsterra's alphanumeric key)
  cdnUrl            String?   // CDN domain the ad network serves tags from
  formatOptions     String?   // JSON: format-specific options (width, height, etc.)
  scriptReference   String?   // sanitized reference (legacy — kept for audit)
  lifecycleState    IntegrationLifecycle @default(DRAFT)
  rejectionReason   String?
  approvedAt        DateTime?
  approvedById      String?
  disabledAt        DateTime?
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adNetwork         AdNetwork  @relation(fields: [adNetworkId], references: [id])
  placements        AdPlacement[]
  approvals         ModerationEvent[]

  @@index([userId])
  @@index([lifecycleState])
  @@index([adNetworkId])
}

enum IntegrationType {
  SCRIPT
  DIRECT_LINK
  NATIVE
  BANNER
  IN_PAGE
  VIGNETTE
  PUSH
  MULTITAG
}

enum IntegrationLifecycle {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DISABLED
  REVOKED
  DELETED
}

model AdPlacement {
  id              String   @id @default(cuid())
  // An ad placement is attached to EITHER a SpecialPage OR a Post.
  // (pageId XOR postId — exactly one must be set.)
  pageId          String?
  postId          String?
  integrationId   String?  // null if this is a platform placement
  source          PlacementSource
  slot            PlacementSlot
  priority        Int      @default(50)  // lower = higher priority
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  page            SpecialPage?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post            Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  integration     AdIntegration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([postId])
  @@index([integrationId])
}

enum PlacementSource {
  USER_INTEGRATION
  PLATFORM_DIRECT
  PLATFORM_NETWORK
}

enum PlacementSlot {
  HEADER
  AFTER_FIRST_BLOCK
  MID_CONTENT
  BEFORE_FOOTER
  FOOTER
  SIDEBAR
}

// ─── TRUST SCORE & MODERATION (Chapter 4) ───────────────────────────────────

model TrustScore {
  id              String   @id @default(cuid())
  pageId          String
  trafficQuality  Int      // 0-100
  contentRisk     Int      // 0-100 (higher = worse)
  adRisk          Int
  spamRisk        Int
  composite       Int
  signalBreakdown String   // JSON
  computedAt      DateTime @default(now())

  page            SpecialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, computedAt])
}

model ModerationEvent {
  id              String   @id @default(cuid())
  pageId          String?
  postId          String?
  integrationId   String?
  fromState       String?
  toState         String
  reason          String
  triggerSignals  String?  // JSON
  triggeredById   String?
  triggeredBy     String   // "automated" or userId
  createdAt       DateTime @default(now())

  page            SpecialPage?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post            Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  integration     AdIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  moderator       User?          @relation(fields: [triggeredById], references: [id])

  @@index([pageId])
  @@index([postId])
  @@index([integrationId])
  @@index([createdAt])
}

// ─── CAMPAIGNS (Christmas 2026 etc.) ─────────────────────────────────────────

model Campaign {
  id              String   @id @default(cuid())
  slug            String   @unique  // "christmas-2026"
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pages           SpecialPage[]
  posts           Post[]
}

// ─── REVENUE LAYERS (Chapter 5) ─────────────────────────────────────────────

model PlatformAdNetworkIntegration {
  // Layer 2: platform's own Adsterra/Monetag publisher account
  // Renders platform-managed ad inventory on eligible Special Pages.
  //
  // Verification lifecycle (separate from user AdIntegration lifecycle):
  //   UNVERIFIED → VERIFYING → VERIFIED → SUSPENDED → UNVERIFIED
  //
  // The admin must:
  //   1. Add the platform domain to their ad-network publisher account
  //   2. Verify site ownership (DNS TXT / meta tag) at the ad network
  //   3. Create an ad zone and obtain the zone ID
  //   4. Enter the zone ID + CDN URL + format options here
  //   5. Click "Run test" to simulate a test request
  //   6. Click "Verify" once they've confirmed the integration works
  //
  // Only VERIFIED integrations are eligible to render ads on Special Pages.
  // The AdRenderer uses cdnUrl + zoneKey + integrationType to emit the actual
  // ad-network script tag that loads real ads.
  id                String                  @id @default(cuid())
  adNetworkId       String
  integrationType   IntegrationType
  zoneIdentifier    String                  // legacy field — the zone ID from the ad network dashboard
  zoneKey           String?                 // ad-network-specific zone key (e.g. Adsterra's alphanumeric key)
  cdnUrl            String?                 // the CDN domain the ad network serves tags from (e.g. "pl12345.profitabledisplaynetwork.com")
  formatOptions     String?                 // JSON: format-specific options (width, height, etc. for banners)
  scriptReference   String                  // sanitized identifier (legacy — kept for audit)
  isActive          Boolean                 @default(true)
  verificationState PlatformVerificationState @default(UNVERIFIED)
  verifiedAt        DateTime?
  verifiedById      String?
  lastTestedAt      DateTime?
  lastTestResult    String?                 // JSON: { ok: boolean, status?: number, message: string, latencyMs?: number }
  verificationNotes String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  adNetwork         AdNetwork @relation(fields: [adNetworkId], references: [id])

  @@index([verificationState])
  @@index([isActive])
}

enum PlatformVerificationState {
  UNVERIFIED
  VERIFYING
  VERIFIED
  SUSPENDED
}

model CreatorSubscription {
  // Layer 4: creator tooling (premium features, custom domain, etc.)
  id              String   @id @default(cuid())
  userId          String
  tier            SubscriptionTier
  status          SubscriptionStatus @default(ACTIVE)
  startedAt       DateTime @default(now())
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SubscriptionTier {
  FREE
  CREATOR_PRO
  CREATOR_BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model PageAnalytics {
  // Aggregated per-page analytics, recomputed nightly (MVP: mock)
  id              String   @id @default(cuid())
  pageId          String   @unique
  visitors7d      Int      @default(0)
  visitors30d     Int      @default(0)
  pageViews7d     Int      @default(0)
  pageViews30d    Int      @default(0)
  uniqueVisitors30d Int    @default(0)
  returningVisitors30d Int @default(0)
  topCountries    String   // JSON: {"GH": 31, "NG": 19, ...}
  topDevices      String   // JSON
  topSources      String   // JSON
  updatedAt       DateTime @updatedAt

  page            SpecialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ─── COMPLIANCE (Chapter 6) ──────────────────────────────────────────────────

model EarningsDisclaimerAck {
  id              String   @id @default(cuid())
  userId          String
  disclaimerVersion String
  acknowledgedAt  DateTime @default(now())
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
