// ─── REVENUE LAYERS (Chapter 5) ─────────────────────────────────────────────

model PlatformAdNetworkIntegration {
  // Layer 2: platform's own Adsterra/Monetag publisher account
  // Renders platform-managed ad inventory on eligible Special Pages.
  //
  // Verification lifecycle (separate from user AdIntegration lifecycle):
  //   UNVERIFIED → VERIFYING → VERIFIED → SUSPENDED → UNVERIFIED
  //
  // The admin must:
  //   1. Add the platform domain to their ad-network publisher account
  //   2. Verify site ownership (DNS TXT / meta tag) at the ad network
  //   3. Create an ad zone and obtain the zone ID
  //   4. Enter the zone ID + CDN URL + format options here
  //   5. Click "Run test" to simulate a test request
  //   6. Click "Verify" once they've confirmed the integration works
  //
  // Only VERIFIED integrations are eligible to render ads on Special Pages.
  // The AdRenderer uses cdnUrl + zoneKey + integrationType to emit the actual
  // ad-network script tag that loads real ads.
  id                String                  @id @default(cuid())
  adNetworkId       String
  integrationType   IntegrationType
  zoneIdentifier    String                  // legacy field — the zone ID from the ad network dashboard
  zoneKey           String?                 // ad-network-specific zone key (e.g. Adsterra's alphanumeric key)
  cdnUrl            String?                 // the CDN domain the ad network serves tags from (e.g. "pl12345.profitabledisplaynetwork.com")
  formatOptions     String?                 // JSON: format-specific options (width, height, etc. for banners)
  scriptReference   String                  // sanitized identifier (legacy — kept for audit)
  isActive          Boolean                 @default(true)
  verificationState PlatformVerificationState @default(UNVERIFIED)
  verifiedAt        DateTime?
  verifiedById      String?
  lastTestedAt      DateTime?
  lastTestResult    String?                 // JSON: { ok: boolean, status?: number, message: string, latencyMs?: number }
  verificationNotes String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  adNetwork         AdNetwork @relation(fields: [adNetworkId], references: [id])

  @@index([verificationState])
  @@index([isActive])
}

enum PlatformVerificationState {
  UNVERIFIED
  VERIFYING
  VERIFIED
  SUSPENDED
}

model CreatorSubscription {
  // Layer 4: creator tooling (premium features, custom domain, etc.)
  id              String   @id @default(cuid())
  userId          String
  tier            SubscriptionTier
  status          SubscriptionStatus @default(ACTIVE)
  startedAt       DateTime @default(now())
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SubscriptionTier {
  FREE
  CREATOR_PRO
  CREATOR_BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model PageAnalytics {
  // Aggregated per-page analytics (legacy — kept for backward compat).
  // Phase 6 adds the AnalyticsEvent model for real event ingestion.
  // The GET /api/analytics/[pageId] route now queries AnalyticsEvent
  // directly instead of reading this mock table.
  id              String   @id @default(cuid())
  pageId          String   @unique
  visitors7d      Int      @default(0)
  visitors30d     Int      @default(0)
  pageViews7d     Int      @default(0)
  pageViews30d    Int      @default(0)
  uniqueVisitors30d Int    @default(0)
  returningVisitors30d Int @default(0)
  topCountries    String   // JSON: {"GH": 31, "NG": 19, ...}
  topDevices      String   // JSON
  topSources      String   // JSON
  updatedAt       DateTime @updatedAt

  page            SpecialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ─── ANALYTICS EVENTS (Phase 6) ───────────────────────────────────────────────
//
// Per spec section 19 (TRAFFIC ANALYTICS):
//   Replace simplistic/mock analytics with a proper analytics event architecture.
//
// Per spec section 60 (ANALYTICS SCALABILITY):
//   Do NOT query millions of raw events for every dashboard request.
//   Architecture: RAW EVENTS → AGGREGATION → HOURLY/DAILY SUMMARIES → DASHBOARD
//
// For MVP, we query raw events with SQL GROUP BY (fast enough at scale < 100K
// events). Phase 13 (Performance) will add AnalyticsDaily aggregation for
// high-volume tables.
//
// Privacy-conscious (spec section 80):
//   - No PII stored (no email, no name, no IP address)
//   - visitorId is a first-party anonymous ID (random cuid, not derived from PII)
//   - countryCode is derived from GeoIP at the edge (Vercel provides this)
//   - No tracking across sites

enum AnalyticsEventType {
  PAGE_VIEW
  POST_VIEW
  LINK_CLICK
  SHARE
  FOLLOW
  REACTION
  COMMENT
  SAVE
  AD_SLOT_VIEW
  SESSION_START
}

model AnalyticsEvent {
  id            String             @id @default(cuid())
  type          AnalyticsEventType
  // The resource being viewed/interacted with. Either pageId OR postId is set.
  pageId        String?
  postId        String?
  // Anonymous visitor ID (first-party, random cuid stored in localStorage).
  // NOT a user ID — we don't track logged-in identity in analytics.
  // Used for unique visitor counting + returning visitor detection.
  visitorId     String
  // Session ID (same visitor, within 30 min of last activity).
  sessionId     String
  // Request metadata (privacy-conscious — no PII)
  referrer      String?            // referring URL (or "direct" if none)
  countryCode   String?            // 2-letter ISO code from GeoIP (e.g., "GH", "US")
  deviceType    String?            // "mobile", "tablet", "desktop"
  browser       String?            // "chrome", "firefox", "safari", "edge", "other"
  // For campaign tracking (spec section 21): ?ref=whatsapp etc.
  campaign      String?
  createdAt     DateTime           @default(now())

  @@index([pageId, type, createdAt])    // page analytics: views by date
  @@index([postId, type, createdAt])    // post analytics: views by date
  @@index([visitorId, createdAt])      // unique visitor counting
  @@index([type, createdAt])            // global event counts
  @@index([createdAt])                  // time-range queries
}

// ─── GROW CENTER (Phase 7) ──────────────────────────────────────────────────
//
// Per spec section 23 (ACTIONABLE INSIGHTS) + section 25 (CREATOR GROWTH):
//   - Insights are computed server-side from real analytics data
//   - Milestones are non-financial achievements (NOT ad clicks/impressions)
//   - Recommendations are actionable suggestions for creator growth
//
// Milestones are predefined (seeded) — e.g., "First Page", "100 Visitors".
// UserMilestone tracks which milestones each user has earned + when.

enum MilestoneType {
  PROFILE_COMPLETE
  FIRST_PAGE
  FIRST_POST
  FIRST_FOLLOWER
  TEN_FOLLOWERS
  HUNDRED_FOLLOWERS
  HUNDRED_VISITORS
  THOUSAND_VISITORS
  FIRST_SHARE
  FIRST_REACTION
  FIRST_COMMENT
  CONSISTENT_CREATOR
  FEATURED_CREATOR
  CAMPAIGN_PARTICIPANT
}

model Milestone {
  id          String        @id @default(cuid())
  type        MilestoneType @unique
  name        String                   // display name
  description String                   // what the user did to earn it
  icon        String                   // emoji or icon name
  color       String                   // hex color for UI accent
  threshold   Int          @default(0) // numeric threshold (e.g., 100 for HUNDRED_VISITORS)
  createdAt   DateTime      @default(now())

  users       UserMilestone[]
}

model UserMilestone {
  id          String   @id @default(cuid())
  userId      String
  milestoneId String
  achievedAt  DateTime @default(now())
  // Whether the user has "claimed" this milestone (seen the celebration)
  claimed     Boolean  @default(false)
  claimedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])  // prevents duplicate milestone awards
  @@index([userId, claimed])
}

// ─── TRUST & SAFETY (Phase 9) ───────────────────────────────────────────────
//
// Per spec section 35 (TRUST & SAFETY) + sections 36-39:
//   - Reports: users can report profiles, pages, posts, comments, links, ads
//   - Block/mute: users can block other users + hide their content
//   - Copyright workflow: structured copyright reporting process
//   - Verification: verified creator / verified business with real review
//
// Per spec section 26: "Do NOT automatically punish legitimate viral activity
// solely because it is high volume." Risk levels are LOW/MEDIUM/HIGH/CRITICAL.

enum ReportReason {
  SPAM
  SCAM
  MALWARE
  HARASSMENT
  IMPERSONATION
  COPYRIGHT
  ADULT_CONTENT
  ILLEGAL_ACTIVITY
  HATEFUL_CONTENT
  VIOLENCE
  MISLEADING_CONTENT
  OTHER
}

enum ReportEntityType {
  USER
  PAGE
  POST
  COMMENT
  LINK
  AD
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

model Report {
  id              String           @id @default(cuid())
  reporterId      String           // who filed the report
  entityType      ReportEntityType
  entityId        String           // the ID of the reported entity
  reason          ReportReason
  description     String?          // additional details from the reporter
  evidence        String?          // JSON: URLs, screenshots, etc.
  status          ReportStatus     @default(PENDING)
  // Admin resolution fields
  resolvedById    String?          // admin/moderator who resolved
  resolution       String?          // explanation of action taken
  resolutionAction String?         // "warning", "suspension", "ban", "content_removed", "no_action"
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?

  reporter        User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver        User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])     // find reports about an entity
  @@index([status, createdAt])        // admin queue: pending reports by date
  @@index([reporterId])
  @@index([createdAt])
}

// Block — user A blocks user B. Blocked content is excluded from feeds,
// search, notifications, and recommendations for the blocking user.
model Block {
  id          String   @id @default(cuid())
  blockerId   String   // the user who blocks
  blockedId   String   // the user being blocked
  createdAt   DateTime @default(now())

  blocker    User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])  // prevents duplicate blocks
  @@index([blockerId])
  @@index([blockedId])
}

// Mute — user A mutes user B. Muted users' content is hidden from the
// muting user's feed, but the muted user can still follow/react/comment
// (they just don't appear in the muter's discovery surfaces).
// Unlike block, mute is one-directional + less severe.
model Mute {
  id          String   @id @default(cuid())
  muterId     String   // the user who mutes
  mutedId     String   // the user being muted
  createdAt   DateTime @default(now())

  muter       User @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted        User @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

// Verification request — per spec section 39 (IMPERSONATION / VERIFICATION):
// "Verification should represent a real verification process."
// Users submit evidence (identity docs, social links, business registration).
// Admins review + approve/deny. Verified users get a badge.
enum VerificationType {
  CREATOR
  BUSINESS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model VerificationRequest {
  id              String             @id @default(cuid())
  userId          String
  type            VerificationType    @default(CREATOR)
  // User-submitted evidence
  realName        String
  bio             String?             // why they should be verified
  websiteUrl      String?
  socialLinks     String?             // JSON: [{platform, url}]
  evidenceUrls    String?             // JSON: [url1, url2] — docs, screenshots
  // Admin review
  status          VerificationStatus  @default(PENDING)
  reviewedById    String?
  reviewNotes     String?             // admin notes on the decision
  reviewedAt      DateTime?
  expiresAt       DateTime?            // verification may expire (e.g., annual)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?  @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

// ─── CREATOR EXPERIENCE (Phase 10) ──────────────────────────────────────────
//
// Per spec section 40 (CREATOR THEMES) + section 71 (EARNOVA STUDIO):
//   - Professional theme system: colors, typography, background, cards
//   - Templates: Minimal, Creator, Business, Portfolio, Music, Gaming,
//     Photography, Celebration, Christmas, Professional
//   - Earnova Studio: greeting cards, social cards, birthday wishes,
//     Christmas wishes, quotes, posters, announcements, quizzes, polls,
//     countdowns, invitations
//
// Themes are predefined (seeded) with CSS variable overrides. Each page
// can optionally have a theme applied — if none, it uses the default
// platform theme.

enum ThemeCategory {
  MINIMAL
  CREATOR
  BUSINESS
  PORTFOLIO
  MUSIC
  GAMING
  PHOTOGRAPHY
  CELEBRATION
  CHRISTMAS
  PROFESSIONAL
}

model Theme {
  id          String        @id @default(cuid())
  slug        String        @unique  // "christmas-wonder", "ocean-breeze", etc.
  name        String                 // display name
  description String?
  category    ThemeCategory
  icon        String                 // emoji
  // CSS variable overrides as JSON — applied to the page's root element
  // e.g., {"--evergreen":"#1a5276","--gold":"#f39c12","--background":"#fefefe"}
  cssVars     String                 // JSON
  // Preview gradient for the theme picker
  previewGradient String             // CSS gradient string
  isPremium   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  pages       SpecialPage[]
}

// Templates are predefined page structures (content blocks + page type +
// theme) that users can use as a starting point.
model PageTemplate {
  id          String        @id @default(cuid())
  slug        String        @unique  // "personal-starter", "christmas-card", etc.
  name        String                 // display name
  description String?
  category    ThemeCategory
  icon        String                 // emoji
  pageType    PageType                // the page type to create
  // Default content blocks as JSON array — used when creating a page from template
  blocks      String                 // JSON: [{type, data, order}]
  themeSlug   String?                // optional theme to apply
  isPremium   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([category])
}

// ─── STUDIO PROJECTS (Phase 10+) ───────────────────────────────────────────
//
// Studio projects are real visual outputs created by users — greeting cards,
// quizzes, polls, countdowns, quotes, posters, etc.
//
// Each project has structured data (JSON) specific to its type. The studio
// editor renders a live preview based on this data. Projects can be:
//   - Embedded into a Special Page as a content block
//   - Shared directly via a dedicated URL
//   - Exported as images (future)
//
// AI Integration (spec section 71):
//   The `aiGenerated` flag tracks whether content was AI-assisted.
//   The `aiPrompt` field stores the prompt used (for audit + re-generation).
//   Future AI providers plug into src/lib/ai/ to generate/suggest content.

enum StudioProjectType {
  GREETING_CARD
  SOCIAL_CARD
  BIRTHDAY_WISH
  CHRISTMAS_WISH
  QUOTE
  POSTER
  ANNOUNCEMENT
  QUIZ
  POLL
  COUNTDOWN
  INVITATION
  EVENT_PAGE
}

model StudioProject {
  id          String             @id @default(cuid())
  ownerId     String
  type        StudioProjectType
  title       String                          // user-given title for the project
  // Structured content data — JSON specific to the project type.
  // Examples:
  //   GREETING_CARD: { recipient, message, backgroundImage, layout, style }
  //   COUNTDOWN: { targetDate, title, subtitle, style }
  //   QUIZ: { questions: [{ question, options[], correctIndex, explanation }] }
  //   POLL: { question, options: [{ text, votes }], style }
  //   QUOTE: { text, author, style, backgroundImage }
  //   POSTER: { title, subtitle, backgroundImage, layout, style }
  data        String                         // JSON
  // Optional: link to a Special Page this project is embedded in
  pageId      String?
  // AI integration fields
  aiGenerated Boolean             @default(false)
  aiPrompt    String?                          // the prompt that generated this content (if AI)
  // Status
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  page        SpecialPage?        @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([ownerId, type])
  @@index([type, isPublished])
  @@index([pageId])
}

// ─── COMPLIANCE (Chapter 6) ──────────────────────────────────────────────────

model EarningsDisclaimerAck {
  id              String   @id @default(cuid())
  userId          String
  disclaimerVersion String
  acknowledgedAt  DateTime @default(now())
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
